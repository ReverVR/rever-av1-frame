@@ -3,15 +3,44 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/interrupt.h>
 #include <linux/pm_runtime.h>
 
 #include "iris_core.h"
+#include "frame_firmware_no_tz.h"
 #include "iris_firmware.h"
 #include "iris_state.h"
 #include "iris_vpu_common.h"
 
+/* Rever lab: a power-collapsed core let go as it is, like Valve's driver - waking it to unload it put the firmware
+ * CPU in reset mid-run, the power-off handshake went unanswered and the controller clock stayed on (KB AV1D-005).
+ * The suspend already did PC prep, CPU reset and power-off: only memory is left to free. Reached through
+ * rever_let_go before rmmod - the driver core wakes the device before iris_remove() */
+bool iris_core_release_collapsed(struct iris_core *core)
+{
+	bool released = false;
+
+	pm_runtime_get_noresume(core->dev);
+	mutex_lock(&core->lock);
+	if (frame_fw_uses_no_tz(core) && core->state == IRIS_CORE_INIT &&
+	    pm_runtime_status_suspended(core->dev)) {
+		dev_info(core->dev, "Rever lab: power-collapsed core let go as it is\n");
+		frame_fw_no_tz_deinit(core);
+		iris_hfi_queues_deinit(core);
+		core->state = IRIS_CORE_DEINIT;
+		released = true;
+	}
+	mutex_unlock(&core->lock);
+	pm_runtime_put_noidle(core->dev);
+
+	return released;
+}
+
 void iris_core_deinit(struct iris_core *core)
 {
+	if (iris_core_release_collapsed(core))
+		return;
+
 	pm_runtime_resume_and_get(core->dev);
 
 	mutex_lock(&core->lock);
@@ -52,8 +81,10 @@
 		ret = 0;
 		goto exit;
 	} else if (core->state == IRIS_CORE_ERROR) {
+		/* Rever lab: left as it is - only a teardown ends the error state (upstream set DEINIT here and the
+		 * next open booted again over a live firmware) */
 		ret = -EINVAL;
-		goto error;
+		goto exit;
 	}
 
 	core->state = IRIS_CORE_INIT;
@@ -80,13 +111,33 @@
 
 	core->iris_firmware_data->init_hfi_ops(core);
 
+	/* Rever lab: a late answer to an earlier, timed-out init must not pass for this one */
+	reinit_completion(&core->core_init_done);
 	ret = iris_hfi_core_init(core);
 	if (ret)
 		goto error_unload_fw;
 
 	mutex_unlock(&core->lock);
 
-	return iris_wait_for_system_response(core);
+	ret = iris_wait_for_system_response(core);
+	if (ret == -ETIMEDOUT) {
+		/* Rever lab: a firmware that never answered is let go - left on, its IRQ stayed enabled and its memory
+		 * mapped for the next open to boot over. disable_irq() first: a handler in flight ends before the
+		 * queues go */
+		disable_irq(core->irq);
+		mutex_lock(&core->lock);
+		if (core->state == IRIS_CORE_ERROR) {
+			dev_err(core->dev, "Rever lab: firmware silent at init, let go\n");
+			iris_fw_unload(core);
+			iris_vpu_power_off(core);
+			iris_hfi_queues_deinit(core);
+			core->state = IRIS_CORE_DEINIT;
+		}
+		mutex_unlock(&core->lock);
+		enable_irq(core->irq);
+	}
+
+	return ret;
 
 error_unload_fw:
 	iris_fw_unload(core);
